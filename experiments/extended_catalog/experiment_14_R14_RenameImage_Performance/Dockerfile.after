FROM alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc AS builder
RUN mkdir -p /build && echo "artifact" > /build/output.txt

FROM alpine@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc AS runtime
COPY --from=builder /build/output.txt /opt/app/output.txt
